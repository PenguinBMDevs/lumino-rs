MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- winit/src/conversion.rs: winit 的 modifier_supplement 模块仅在
  windows/macos/x11/wayland/orbital 下编译（android 被排除），原实现
  `key_without_modifiers()` / `text_with_all_modifiers()` 在 android 上直接
  `E0432 unresolved import`，iced_winit 整体编不过。android 分支改用
  `logical_key`，text 缺失时回退 `Key::Character`。
- graphics/src/text.rs: fontdb 0.23 的 load_system_fonts() 对 android 显式跳过
  （cfg 排除），导致 android 上字体库只有内嵌字体、中文全是豆腐块。显式
  load_fonts_dir("/system/fonts") 并补齐 sans/serif/mono 默认族名。
- wgpu/{lib,text}.rs: 迁入 LUMINO 的段落强引用钉修复（段落弱引用在渲染线程
  prepare 前死亡会导致整段文字静默不绘制）与 LUMINO_TEXT_TRACE 诊断日志。
---
 graphics/src/text.rs    | 34 ++++++++++++++++------
 wgpu/src/lib.rs         | 22 +++++++++++++++
 wgpu/src/text.rs        | 62 ++++++++++++++++++++++++++++++++++++++++-
 winit/src/conversion.rs | 21 ++++++++++++--
 4 files changed, 127 insertions(+), 12 deletions(-)

diff --git a/graphics/src/text.rs b/graphics/src/text.rs
index 35ff24f..9a6dac8 100644
--- a/graphics/src/text.rs
+++ b/graphics/src/text.rs
@@ -117,16 +117,32 @@ pub fn font_system() -> &'static RwLock<FontSystem> {
     static FONT_SYSTEM: OnceLock<RwLock<FontSystem>> = OnceLock::new();
 
     FONT_SYSTEM.get_or_init(|| {
+        let mut raw = cosmic_text::FontSystem::new_with_fonts([
+            cosmic_text::fontdb::Source::Binary(Arc::new(
+                include_bytes!("../fonts/Iced-Icons.ttf").as_slice(),
+            )),
+            #[cfg(feature = "fira-sans")]
+            cosmic_text::fontdb::Source::Binary(Arc::new(
+                include_bytes!("../fonts/FiraSans-Regular.ttf").as_slice(),
+            )),
+        ]);
+
+        // [LUMINO PATCH] fontdb 0.23 的 `load_system_fonts()` 对 android 显式跳过
+        // （`#[cfg(all(unix, not(any(target_os = "macos", target_os = "android"))))]`），
+        // 结果是 android 上字体库只有内嵌字体——中文全体豆腐块。必须显式扫描
+        // `/system/fonts` 并补上默认族名，否则 `Family::SansSerif` 无解析目标。
+        #[cfg(target_os = "android")]
+        {
+            raw.db_mut().load_fonts_dir("/system/fonts");
+            raw.db_mut().set_sans_serif_family("Roboto");
+            raw.db_mut().set_serif_family("Noto Serif");
+            raw.db_mut().set_monospace_family("Droid Sans Mono");
+            raw.db_mut().set_cursive_family("Dancing Script");
+            raw.db_mut().set_fantasy_family("Dancing Script");
+        }
+
         RwLock::new(FontSystem {
-            raw: cosmic_text::FontSystem::new_with_fonts([
-                cosmic_text::fontdb::Source::Binary(Arc::new(
-                    include_bytes!("../fonts/Iced-Icons.ttf").as_slice(),
-                )),
-                #[cfg(feature = "fira-sans")]
-                cosmic_text::fontdb::Source::Binary(Arc::new(
-                    include_bytes!("../fonts/FiraSans-Regular.ttf").as_slice(),
-                )),
-            ]),
+            raw,
             loaded_fonts: HashSet::new(),
             version: Version::default(),
         })
